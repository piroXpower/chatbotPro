# ==============================================================
# Telegram Credentials (Required)
# Get API_ID and API_HASH from: https://my.telegram.org
# Get BOT_TOKEN from: https://t.me/BotFather
# ==============================================================
API_ID=12345678
API_HASH=abcdef1234567890abcdef1234567890
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# ==============================================================
# Telegram Channel Database (Required)
# Create a private channel in Telegram, add your bot as Admin,
# and put the Channel ID here (starts with -100).
# Example: -1001234567890
# ==============================================================
DB_CHANNEL_ID=-1001234567890

# ==============================================================
# Optional Configurations
# ==============================================================
# Bot Persona Name (Default: Alex)
BOT_NAME=Alex

# Owner/Admin Telegram User ID (Optional - for /stats and /sync)
OWNER_ID=123456789

# Database Auto-Sync interval to channel (in seconds, default: 300 = 5 mins)
SYNC_INTERVAL_SECONDS=300

# Optional AI API Keys (Not needed! Free AI works out of the box with zero keys)
# GEMINI_API_KEY=
# GROQ_API_KEY=
